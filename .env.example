NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Integração com o ADM (AceleraMatCon) — verificação de CNPJ/associado.
# ADM_VERIFY_URL aponta para POST /api/academy/verificar-cnpj no projeto do ADM.
# ADM_VERIFY_SECRET é o mesmo valor configurado lá como ACADEMY_VERIFY_SECRET.
ADM_VERIFY_URL=
ADM_VERIFY_SECRET=

# Segredo do webhook de revogação (Fase 6) — o mesmo valor fica guardado no
# ADM (tabela configuracoes) e assina o payload que o trigger de empresas
# manda via pg_net para POST /api/associados/revogar.
ADM_REVOKE_SECRET=

# Chave de serviço do Supabase — usada só no servidor (src/lib/supabase/service.ts)
# para escrever em academy_vinculos, tabela sem nenhum grant a anon/authenticated.
SUPABASE_SERVICE_ROLE_KEY=
